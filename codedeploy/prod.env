# See Weblate documentation for detailed description:
# https://docs.weblate.org/en/latest/admin/install/docker.html#generic-settings

# Weblate setup
WEBLATE_SITE_DOMAIN=weblate.hexxy.media
WEBLATE_ADMIN_PASSWORD=
WEBLATE_ALLOWED_HOSTS=weblate.hexxy.media,hexxy-weblate.object.gay

# SSL configuration should match your SSL termination setup
WEBLATE_ENABLE_HTTPS=1
WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
